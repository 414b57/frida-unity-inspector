{
    "_comment": [
        "Single source of truth for everything crossing the Python <-> agent boundary.",
        "",
        "Type vocabulary: string | int | float | bool | null | any,",
        "  `T?` for nullable, `list<T>`, `map<K, V>`, tuple<T1, T2, ...>.",
        "",
        "To add a new function/capability/event, add it to the appropriate section below. The agent will automatically generate the necessary code to handle it.",
        "",
        "TODO - Look into replacing this with something like yaml, so can have comments"
    ],

    "message_types": {
        "EVENT": "event"
    },

    "events": {
        "AGENT_LOADED": {
            "name": "agent_loaded",
            "data": "null"
        },
        "AGENT_READY": {
            "name": "agent_ready",
            "data": "map<string, bool>"
        }
    },

    "builtins": {
        "CAPABILITIES": {
            "name": "capabilities",
            "args": [],
            "returns": "map<string, bool>"
        },
        "VERSION": {
            "name": "version",
            "args": [],
            "returns": "string"
        },
        "UNITY_VERSION": {
            "name": "unityVersion",
            "args": [],
            "returns": "string"
        },
        "PING": {
            "name": "ping",
            "args": [{
                "name": "unix_epoch_seconds",
                "type": "float"
            }],
            "returns": "tuple<float, float>"
        }
    },

    "capabilities": {
        "GET_CURRENT_RENDER_PIPELINE": {
            "name": "getCurrentRenderPipeline",
            "args": [],
            "returns": "string?"
        }
    }
}
