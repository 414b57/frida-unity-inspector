# Android device (phone over USB/ADB)
# Requires: adb on PATH, USB debugging enabled, and a rooted device so the bundled frida-server can be pushed to /data/local/tmp and started.

# logging
FUI_LOG_LEVEL=INFO
FUI_UVICORN_LOG_LEVEL=info

# data source
FUI_DATA_SOURCE=frida

# frida
#FUI_UNITY_VERSION=6000.0.63f1 # - ONLY SET IF IL2CPP BRIDGE FAILS TO LOAD. Otherwise, leave it commented out and the inspector will try to detect it automatically.

# device
FUI_DEVICE=adb
FUI_PACKAGE=com.PlapPlap.FridaTestingEnv
FUI_SPAWN=true
FUI_KILL_ON_STOP=true

# hosting
FUI_HOST=localhost
FUI_PORT=8000
FUI_WEB_APP=unity_editor
